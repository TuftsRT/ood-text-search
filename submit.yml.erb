# Job submission configuration file
#
---
batch_connect:
  template: "basic"

script:
  email_on_started: true
  email_on_terminated: true
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/TextSearch"
  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "--partition=<%= partition %>"
<%
  # gpu_type from resource_discovery.erb is a feature variant like "a100-40G".
  # The gres name is the part before the first "-"; the full variant is a
  # node constraint. Empty/"none" (CPU/batch partitions) => no GPU request.
  gres_name = gpu_type.to_s.split('-', 2).first.to_s
  skip_gres = gres_name.empty? || gres_name == "none"
%>
<% if gres_name == "any" %>
    - "--gres=gpu:1"
<% elsif !skip_gres %>
    - "--gres=gpu:<%= gres_name %>:1"
  <% if gpu_type.include?('-') %>
    - "--constraint=<%= gpu_type %>"
  <% end %>
<% end %>
<%-
  # QOS rules live in the shared partition_qos.rb (preempt -> preempt,
  # lab partitions -> normal-contrib, interactive only where allowed).
  load '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
  qos = PartitionQos.qos_for(partition, (ta_qos if defined?(ta_qos)))
-%>
<%- if qos -%>
    - "--qos=<%= qos %>"
<%- end -%>
