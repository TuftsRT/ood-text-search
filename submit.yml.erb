# Job submission configuration file
# 
---
batch_connect:
  template: "basic"

script:
  email_on_started: true
  email_on_terminated: true
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/TextSearch"
  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "-p <%= partition %>"
<% unless skip_gres %>
  <% if gpu_type == "a100_40" %>
    - "--gres=gpu:a100:1"
    - "--constraint=a100-40G"
  <% elsif gpu_type == "a100_80" %>
    - "--gres=gpu:a100:1"
    - "--constraint=a100-80G"
  <% elsif gpu_type == "any" %>
    - "--gres=gpu:1"
  <% else %>
    - "--gres=gpu:<%= gpu_type %>:1"
  <% end %>
<% end %>
    <%- if defined?(ta_qos) && ta_qos == "interactive" -%>
    - "--qos=<%= ta_qos %>"
    <%- end -%>
