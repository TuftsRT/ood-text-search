---
<%
@partition_filter = :all
@partition_qos_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
_partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
ERB.new(File.read(_partial_path)).result(binding)
%>
<%
# resource_discovery.erb's generators take no per-app options, so apply this
# app's default value and extra help text to the generated field YAML.
# extra_help is also set as data-extra-help so form.js keeps it when it
# rewrites the help text on partition/GPU changes.
def customize_field(yaml, default_value:, extra_help:)
  yaml.sub(/^  value: .*$/) { "  value: #{default_value}" }
      .sub(/^    data:\n/) { "    data:\n      extra_help: '#{extra_help.gsub("'", "''")}'\n" }
      .sub(/^  help: "(.*)"$/) { "  help: \"#{$1} #{extra_help.gsub('"') { '\\"' }}\"" }
end
%>

cluster: "pax"
bc_dynamic_js: true

attributes:
<%= generate_partition_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= customize_field(generate_num_cores_field,
      default_value: 8,
      extra_help: "Scale this with the size of your document collection and which search " \
                  "modes you enable; semantic search benefits from more cores. " \
                  "If unsure, the default above is a reasonable starting point."
    ).indent(2) %>
<%= customize_field(generate_num_memory_field,
      default_value: 32,
      extra_help: "A simple starting point is roughly double your selected core count, in GB " \
                  "(for example, 8 cores suggests about 16GB memory). Semantic search over a " \
                  "large collection needs proportionally more."
    ).indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  data_path:
    widget: "path_selector"
    required: true
    label: "Input texts directory"
    help: |
      The file path to the directory of .txt files that will be searched.

  queries:
    widget: "text_field"
    required: true
    label: "Queries to search for in the text files"
    help: |
      The queries to search for in the .txt files.

  result_file_path:
    widget: "path_selector"
    required: true
    label: "Result file path"
    help: |
      The file path to the directory where the results will be saved.

  use_lemmas:
    widget: 'check_box'
    label: 'Use Lemmas'
    help: |
      Check this box to use lemmas in the search instead of the original words.
    checked_value: 'true'
    unchecked_value: 'false'
    default: 'false'

  use_tfidf:
    widget: 'check_box'
    label: 'Use TF-IDF'
    help: |
      Check this box to use TF-IDF weighting in the search.
    checked_value: 'true'
    unchecked_value: 'false'
    default: 'false'

  use_semantic:
    widget: 'check_box'
    label: 'Use Semantic Search'
    help: |
      Check this box to use semantic search in the search.
    checked_value: 'true'
    unchecked_value: 'false'
    default: 'false'

  beta:
    widget: 'number_field'
    label: 'Beta Parameter for Composite Score'
    help: |
      The beta parameter for the composite score calculation. Default is 0.5.
    value: 0.5
    step: 0.1
    min: 0.0
    max: 1.0

  workdir:
    label: "Working Directory"
    widget: "path_selector"
    directory: "/cluster/tufts"
    required: false
    label: Working directory
    favorites:
        - /cluster/tufts
        - /cluster/home

  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"

  docs_link_block:
    widget: text_field
    class: "d-none"
    skip_label: true
    help: |
      For full documentation on this tool, see the [AI Tools guide](https://go.tufts.edu/AITools).

  disclaimer_block:
    widget: text_field
    class: "d-none"
    skip_label: true
<% if File.exist?("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md")  %>
    help: |
<%= File.read("/etc/ood/config/apps/dashboard/batch_connect/partials/ai_disclaimer.md").indent(11) %>
<%end%>

form:
  - docs_link_block
  - disclaimer_block
  - partition  
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_type
  - data_path
  - queries
  - result_file_path
  - use_lemmas
  - use_tfidf
  - use_semantic
  - beta
  - workdir
  - ta_qos
